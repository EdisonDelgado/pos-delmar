# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pos_delmar

# Backend Configuration
BACKEND_PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pos_delmar
DB_SYNC=true
DB_LOGGING=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h

# CORS Configuration (múltiples orígenes separados por coma)
CORS_ORIGIN=http://localhost,http://localhost:80,http://frontend

# Frontend Configuration
FRONTEND_PORT=80
# URL del backend accesible desde el navegador (fuera de Docker)
VITE_API_URL=http://localhost:3000/api
